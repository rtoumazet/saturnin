#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform highp image2D out_image;
layout(binding = 0) uniform sampler2DArray atlas;

struct GpuVertex { vec4 pos; vec4 tex; vec4 color; vec4 gouraud; vec4 offset_pos; vec4 offset_val; };
struct GpuPart   { uint first; uint count; uint flags; uint pad; vec4 bounds; };

layout(std430, binding = 1) buffer VertexBuffer { GpuVertex verts[]; };
layout(std430, binding = 2) buffer PartBuffer   { GpuPart   parts[]; };
// Per-tile part buckets: tile_offsets[t] .. tile_offsets[t + 1] index into tile_indices, which
// holds part indices in draw order (painter's order) for that tile.
layout(std430, binding = 3) buffer TileIndexBuffer  { uint tile_indices[]; };
layout(std430, binding = 4) buffer TileOffsetBuffer { uint tile_offsets[]; };

uniform vec2  fb_size;
uniform ivec2 dispatch_origin;
uniform int   tiles_x;

const uint PRIM_POLYGON  = 0u;
const uint PRIM_POLYLINE = 1u;
const uint PRIM_LINE     = 2u;

// GL rasterizes 1-pixel lines with the diamond-exit rule: |dx| + |dy| < 0.5 from the segment.
float lineDiamondDistance(vec2 a, vec2 b, vec2 p) {
    vec2  ab   = b - a;
    float len2 = dot(ab, ab);
    if (len2 < 1e-6) { return abs(p.x - a.x) + abs(p.y - a.y); }
    float t = clamp(dot(p - a, ab) / len2, 0.0, 1.0);
    vec2  q = a + t * ab;
    return abs(q.x - p.x) + abs(q.y - p.y);
}

float edge(vec2 a, vec2 b, vec2 p) {
    return (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x);
}

// GL top-left fill rule (window coords, y up): for a CCW triangle (interior w > 0), a pixel center
// exactly on an edge (w == 0) is drawn only if that edge is a top or left edge.
bool edgeTopLeft(vec2 a, vec2 b) {
    float dx = b.x - a.x, dy = b.y - a.y;
    return (dy < 0.0f) || (dy == 0.0f && dx < 0.0f);
}

// Triangle coverage of pixel center p, both windings accepted, GL fill rule on boundaries.
bool triCovers(vec2 sa, vec2 sb, vec2 sc, vec2 p) {
    float w0 = edge(sb, sc, p), w1 = edge(sc, sa, p), w2 = edge(sa, sb, p);
    float area = w0 + w1 + w2;
    if (abs(area) < 1e-6) { return false; }
    if (area > 0.0f) {
        return (w0 > 0.0f || (w0 == 0.0f && edgeTopLeft(sb, sc)))
            && (w1 > 0.0f || (w1 == 0.0f && edgeTopLeft(sc, sa)))
            && (w2 > 0.0f || (w2 == 0.0f && edgeTopLeft(sa, sb)));
    }
    // CW triangle: mirror the rule so a shared edge is drawn by exactly one of the two triangles.
    return (w0 < 0.0f || (w0 == 0.0f && !edgeTopLeft(sb, sc)))
        && (w1 < 0.0f || (w1 == 0.0f && !edgeTopLeft(sc, sa)))
        && (w2 < 0.0f || (w2 == 0.0f && !edgeTopLeft(sa, sb)));
}

// GL diamond-exit rule for 1-pixel lines: pixel center c is drawn if the segment intersects the
// interior of its diamond |dx|+|dy| < 0.5 around c, or touches the boundary while exiting the
// diamond through the top or right edge.
bool lineCovers(vec2 a, vec2 b, vec2 c, out float tOut) {
    vec2  d    = b - a;
    float len2 = dot(d, d);
    tOut = 0.0f;
    if (len2 < 1e-12f) { return false; } // zero-length segments draw nothing here
    if (c.x < min(a.x, b.x) - 0.5f || c.x > max(a.x, b.x) + 0.5f
        || c.y < min(a.y, b.y) - 0.5f || c.y > max(a.y, b.y) + 0.5f) { return false; }
    float t = clamp(dot(c - a, d) / len2, 0.0f, 1.0f);
    vec2  q = a + t * d;
    float m = abs(q.x - c.x) + abs(q.y - c.y);
    tOut = t;
    if (m < 0.5f) { return true; }
    if (m > 0.5f) { return false; }
    // On the diamond boundary: draw only if the segment exits through the top or right edge.
    return (d.y > 0.0f) || (d.y == 0.0f && d.x > 0.0f);
}

// Same maths as main.frag.
vec4 shade(bool textured, vec4 vc, vec4 tc, vec4 grd, vec4 op, vec4 ov) {
    vec4 c = textured ? texture(atlas, vec3(tc.x, tc.y, tc.z)) : vc;
    c.rgb += grd.rgb;
    c.r += op.r > 0.0 ? ov.r : -ov.r;
    c.g += op.g > 0.0 ? ov.g : -ov.g;
    c.b += op.b > 0.0 ? ov.b : -ov.b;
    c.rgb = clamp(c.rgb, vec3(0.0), vec3(1.0));
    return c;
}

void main() {
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy) + dispatch_origin;
    if (ip.x >= int(fb_size.x) || ip.y >= int(fb_size.y)) { return; }

    vec2 p = vec2(ip) + vec2(0.5);
    // Start from the cleared destination, like GL_SRC_ALPHA / GL_ONE_MINUS_SRC_ALPHA blending.
    vec4 color = imageLoad(out_image, ip);

    // One workgroup rasterizes exactly one tile, so a pixel only inspects the parts overlapping
    // that tile instead of the whole parts list.
    int  tile         = int(gl_WorkGroupID.y) * tiles_x + int(gl_WorkGroupID.x);
    uint bucket_begin = tile_offsets[tile];
    uint bucket_end   = tile_offsets[tile + 1];
    if (bucket_begin == bucket_end) { return; }

    // Painter's order: later parts overwrite earlier ones.
    for (uint k = bucket_begin; k < bucket_end; ++k) {
        int pi = int(tile_indices[k]);
        uint flags    = parts[pi].flags;
        uint prim     = (flags >> 1u) & 3u;
        bool textured = (flags & 1u) != 0u;
        int first = int(parts[pi].first);
        int count = int(parts[pi].count);
        vec4 bounds = parts[pi].bounds;
        if (p.x < bounds.x || p.x > bounds.z || p.y < bounds.y || p.y > bounds.w) { continue; }

        if (prim == PRIM_POLYLINE || prim == PRIM_LINE) {
            int segments = (prim == PRIM_LINE) ? 1 : count;
            for (int s = 0; s < segments; ++s) {
                GpuVertex va = verts[first + s];
                GpuVertex vb = verts[first + ((s + 1) % count)];
                float t = 0.0f;
                if (!lineCovers(va.pos.xy, vb.pos.xy, p, t)) { continue; }
                vec4 src = shade(textured,
                    va.color * (1.0 - t) + vb.color * t,
                    va.tex   * (1.0 - t) + vb.tex   * t,
                    va.gouraud * (1.0 - t) + vb.gouraud * t,
                    va.offset_pos * (1.0 - t) + vb.offset_pos * t,
                    va.offset_val * (1.0 - t) + vb.offset_val * t);
                color = vec4(src.rgb * src.a + color.rgb * (1.0 - src.a),
                             src.a + color.a * (1.0 - src.a));
                break; // diamond-exit rule: a pixel is owned by exactly one segment
            }
            continue;
        }

        for (int i = 1; i < count - 1; ++i) {
            GpuVertex a = verts[first];
            GpuVertex b = verts[first + i];
            GpuVertex c = verts[first + i + 1];
            vec2 sa = a.pos.xy;
            vec2 sb = b.pos.xy;
            vec2 sc = c.pos.xy;
            if (!triCovers(sa, sb, sc, p)) { continue; }
            {
                // Barycentric weights for interpolation (same edge values as the coverage test).
                float w0 = edge(sb, sc, p), w1 = edge(sc, sa, p), w2 = edge(sa, sb, p);
                float area = w0 + w1 + w2;
                vec3 w = vec3(w0, w1, w2) / area;
                vec4 src = shade(textured,
                    a.color * w.x + b.color * w.y + c.color * w.z,
                    a.tex   * w.x + b.tex   * w.y + c.tex   * w.z,
                    a.gouraud * w.x + b.gouraud * w.y + c.gouraud * w.z,
                    a.offset_pos * w.x + b.offset_pos * w.y + c.offset_pos * w.z,
                    a.offset_val * w.x + b.offset_val * w.y + c.offset_val * w.z);
                color = vec4(src.rgb * src.a + color.rgb * (1.0 - src.a),
                             src.a + color.a * (1.0 - src.a));
            }
        }
    }
    imageStore(out_image, ip, color);
}
